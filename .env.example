# Copia este archivo como .env en la raiz del backend.
# No compartas ni subas .env: contiene credenciales locales.

# Servidor
PORT=4242

# Frontend y CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173

# Supabase y FakeMoney (solo se usan en develop; usa el proyecto DEV)
NODE_ENV=development
FAKE_MONEY_ENABLED=true
SUPABASE_URL=https://URL-DEL-PROYECTO-DEV.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REEMPLAZA_CON_LA_CLAVE_DEV

# Stripe (solo backend; deja vacio para mantener pagos desactivados)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Correo de contacto (SMTP); usa una contrasena de aplicacion y no la publiques
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@example.com
SMTP_PASS=REEMPLAZA_CON_LA_CONTRASENA_DE_APLICACION
SMTP_FROM=tu-cuenta@example.com

# La publishable key de Supabase va en el .env.local del frontend,
# como VITE_SUPABASE_PUBLISHABLE_KEY; no se necesita en este backend.
